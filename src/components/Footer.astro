const today = new Date();
---

<footer class="bg-base-200 text-base-content py-6 mt-12 border-t">
  <nav class="fixed bottom-0 left-0 w-full z-40 bg-base-200 border-t flex flex-wrap justify-center gap-2 sm:gap-4 text-sm font-medium tracking-tight max-w-full overflow-x-auto px-1 md:static md:mb-6 md:border-b md:pb-4">
    <a class="link link-accent" href="/">Home</a>
    <a class="link link-accent" href="/about">About</a>
    <a class="link link-accent" href="/projects">Projects</a>
    <a class="link link-accent" href="/services">Services</a>
    <a class="link link-accent" href="/store">Store</a>
    <a class="link link-accent" href="/blog/">Blog</a>
    <a class="link link-accent" href="/contact">Contact</a>
  </nav>
  <div class="max-w-4xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-4 mt-16 md:mt-0">
    <div class="text-center md:text-left">
      <span class="font-bold">Faithful Craftsmen</span> © 2025<br />
      Handcrafted with heart, built on faith.
    </div>
    <div class="text-center text-sm italic">
      "Whatever you do, work heartily, as for the Lord and not for men."<br />
      <span class="not-italic">— Colossians 3:23</span>
    </div>
