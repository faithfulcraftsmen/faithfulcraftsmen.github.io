---
const { title, img, desc, url, badge, tags, pricing, oldPricing, checkoutUrl, custom_link, custom_link_label, target = "_self" } = Astro.props;
import { Image } from "astro:assets";
const tag_url = url && url.split("/").slice(0, -1).join("/") + "/tag";
---
<!-- Standardized horizontal card layout for projects, blog posts, and shop items -->
<a href={url} target={target} class="block group">
  <div class="flex flex-col md:flex-row items-center gap-6 rounded-lg bg-base-100 hover:shadow-2xl transition ease-in-out hover:scale-[102%] cursor-pointer p-4">
    {img && (
      <Image
        src={img}
        width={750}
        height={422}
        format="webp"
        alt={title}
        class="w-full md:w-[13rem] h-auto rounded-lg mb-4 md:mb-0"
      />
    )}
    <div class="flex-1 w-full">
      <h1 class="text-xl font-bold group-hover:underline group-hover:text-accent transition-colors flex items-center flex-wrap">
        {title}
        {badge && <div class="badge badge-accent mx-2">{badge}</div>}
      </h1>
      {pricing && (
        <div class="mb-1 flex items-baseline gap-2">
          <span class="text-xl font-semibold">{pricing}</span>
          {oldPricing && <span class="text-md opacity-50 line-through">{oldPricing}</span>}
        </div>
      )}
      <p class="py-1 text-1xl">{desc}</p>
      {tags && (
        <div class="card-actions justify-end flex flex-wrap gap-2 mt-2">
          {tags.map((tag) => (
            <a href={`${tag_url}/${tag}`} class="badge badge-accent" onclick="event.stopPropagation();">{tag}</a>
          ))}
        </div>
      )}
      {(checkoutUrl || custom_link) && (
        <div class="flex gap-2 mt-3">
          {custom_link && (
            <a class="btn btn-accent btn-sm" href={custom_link} target="_blank">{custom_link_label || "Details"}</a>
          )}
          {checkoutUrl && (
            <a class="btn btn-accent btn-sm" href={checkoutUrl} target="_blank">Buy Now</a>
          )}
        </div>
      )}
    </div>
  </div>
</a>
