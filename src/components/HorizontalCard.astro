---
const { title, img, desc, url, badge, tags, target = "_self" } = Astro.props;
import { Image } from "astro:assets";
const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";
---

<a href={url} target={target} class="block group">
  <div
    class="flex flex-col md:flex-row items-center gap-6 rounded-lg bg-base-100 hover:shadow-2xl transition ease-in-out hover:scale-[102%] cursor-pointer p-4"
  >
    {img && (
      <Image
        src={img}
        width={750}
        height={422}
        format="webp"
        alt={title}
        class="w-full md:w-[13rem] h-auto rounded-lg mb-4 md:mb-0"
      />
    )}
    <div class="flex-1 w-full">
      <h1 class="text-xl font-bold group-hover:underline group-hover:text-accent transition-colors">
        {title}
        {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
      </h1>
      <p class="py-1 text-1xl">{desc}</p>
      <div class="card-actions justify-end">
        {tags &&
          tags.map((tag) => (
            <a href={`${tag_url}/${tag}`} class="badge badge-outline" onclick="event.stopPropagation();">
              {tag}
            </a>
          ))}
      </div>
    </div>
  </div>
</a>
