---
---
<div class="sticky top-0 z-30 flex h-16 w-full justify-between items-center px-4 bg-base-200 text-base-content shadow-sm bg-opacity-95 backdrop-blur transition-all duration-100">
  <!-- Branding/Logo -->
  <a class="flex items-center gap-2 btn btn-ghost normal-case text-xl px-2" href="/">
    <img src="/faithfulcraftsmen_logo.svg" alt="Faithful Craftsmen Logo" class="w-8 h-8 rounded-full" />
    Faithful Craftsmen
  </a>
  <!-- Hamburger for Mobile -->
  <div class="md:hidden">
    <input id="nav-toggle" type="checkbox" class="hidden peer" />
    <label for="nav-toggle" class="btn btn-ghost btn-circle text-accent">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </label>
    <div class="absolute top-16 left-0 w-full bg-base-200 shadow-lg flex flex-col items-center gap-2 py-4 z-40 transition-all duration-200 scale-y-0 origin-top peer-checked:scale-y-100">
      <a class="link link-hover w-full text-center py-2" href="/about">About</a>
      <a class="link link-hover w-full text-center py-2" href="/projects">Projects</a>
      <a class="link link-hover w-full text-center py-2" href="/services">Services</a>
      <a class="link link-hover w-full text-center py-2" href="/store">Store</a>
      <a class="link link-hover w-full text-center py-2" href="/blog/">Blog</a>
      <a class="link link-hover w-full text-center py-2" href="/contact">Contact</a>
    </div>
  </div>
  <!-- Navigation Links -->
  <nav class="hidden md:flex gap-4 justify-center items-center" style="position: absolute; left: 50%; transform: translateX(-50%);">
    <a class="link link-accent" href="/about">About</a>
    <a class="link link-accent" href="/projects">Projects</a>
    <a class="link link-accent" href="/services">Services</a>
    <a class="link link-accent" href="/store">Store</a>
    <a class="link link-accent" href="/blog/">Blog</a>
    <a class="link link-accent" href="/contact">Contact</a>
  </nav>
  <!-- Theme Switcher: Single Icon Toggle -->
  <button id="theme-toggle" class="btn btn-ghost btn-xs ml-2 flex items-center justify-center" title="Switch theme" aria-label="Switch theme" type="button">
    <span id="theme-icon" class="flex items-center justify-center"></span>
  </button>
  <script is:inline>
    var themes = [
      { name: "light", icon: "<svg xmlns='http://www.w3.org/2000/svg' class='h-5 w-5' fill='none' viewBox='0 0 24 24' stroke='currentColor'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 3v1m0 16v1m8.66-13.66l-.71.71M4.05 19.07l-.71.71M21 12h-1M4 12H3m16.66 5.66l-.71-.71M4.05 4.93l-.71-.71M16 12a4 4 0 11-8 0 4 4 0 018 0z' /></svg>" },
      { name: "dark", icon: "<svg xmlns='http://www.w3.org/2000/svg' class='h-5 w-5' fill='none' viewBox='0 0 24 24' stroke='currentColor'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z' /></svg>" },
      { name: "wood", icon: "<span class='text-lg' style='display:inline-flex;align-items:center;line-height:1;'>🌲</span>" }
    ];
    function getTheme() {
      return localStorage.getItem('theme') || 'light';
    }
    function setTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('theme', theme);
    }
    function updateIcon(theme) {
      var idx = themes.findIndex(function(t) { return t.name === theme; });
      var icon = themes[idx]?.icon || themes[0].icon;
      var iconEl = document.getElementById('theme-icon');
      if (iconEl) iconEl.innerHTML = icon;
    }
    function cycleTheme() {
      var current = getTheme();
      var idx = themes.findIndex(function(t) { return t.name === current; });
      var next = themes[(idx + 1) % themes.length].name;
      setTheme(next);
      updateIcon(next);
    }
    document.addEventListener('DOMContentLoaded', function() {
      setTimeout(function() {
        var current = getTheme();
        setTheme(current);
        updateIcon(current);
        var btn = document.getElementById('theme-toggle');
        if (btn) btn.onclick = cycleTheme;
      }, 0);
    });
  </script>
</div>
