<div class="sticky top-0 z-30 flex h-16 w-full justify-between items-center px-4 bg-base-200 text-base-content shadow-sm bg-opacity-95 backdrop-blur transition-all duration-100">
  <!-- Branding/Logo -->
  <a class="flex items-center gap-2 btn btn-ghost normal-case text-xl px-2" href="/">
    <img src="/faithfulcraftsmen_logo.svg" alt="Faithful Craftsmen Logo" class="w-8 h-8 rounded-full" />
    Faithful Craftsmen
  </a>
  <!-- Hamburger for Mobile -->
  <div class="md:hidden">
    <input id="nav-toggle" type="checkbox" class="hidden peer" />
    <label for="nav-toggle" class="btn btn-ghost btn-circle">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </label>
    <div class="absolute top-16 left-0 w-full bg-base-200 shadow-lg flex flex-col items-center gap-2 py-4 z-40 transition-all duration-200 scale-y-0 origin-top peer-checked:scale-y-100">
      <a class="link link-hover w-full text-center py-2" href="/about">About</a>
      <a class="link link-hover w-full text-center py-2" href="/projects">Projects</a>
      <a class="link link-hover w-full text-center py-2" href="/services">Services</a>
      <a class="link link-hover w-full text-center py-2" href="/store">Store</a>
      <a class="link link-hover w-full text-center py-2" href="/blog/">Blog</a>
      <a class="link link-hover w-full text-center py-2" href="/contact">Contact</a>
    </div>
  </div>
  <!-- Navigation Links -->
  <nav class="hidden md:flex gap-4 justify-center items-center" style="position: absolute; left: 50%; transform: translateX(-50%);">
    <a class="link link-hover" href="/about">About</a>
    <a class="link link-hover" href="/projects">Projects</a>
    <a class="link link-hover" href="/services">Services</a>
    <a class="link link-hover" href="/store">Store</a>
    <a class="link link-hover" href="/blog/">Blog</a>
    <a class="link link-hover" href="/contact">Contact</a>
  </nav>
  <!-- Theme Switcher -->
  <div class="flex gap-1">
    <button class="btn btn-ghost btn-xs" title="Light" onclick="document.documentElement.setAttribute('data-theme', 'light'); localStorage.setItem('theme', 'light');">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m8.66-13.66l-.71.71M4.05 19.07l-.71.71M21 12h-1M4 12H3m16.66 5.66l-.71-.71M4.05 4.93l-.71-.71M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
    </button>
    <button class="btn btn-ghost btn-xs" title="Dark" onclick="document.documentElement.setAttribute('data-theme', 'dark'); localStorage.setItem('theme', 'dark');">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z" /></svg>
    </button>
    <button class="btn btn-ghost btn-xs" title="Wood" onclick="document.documentElement.setAttribute('data-theme', 'wood'); localStorage.setItem('theme', 'wood');">
      <span class="text-lg">🌲</span>
    </button>
  </div>
</div>
