---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout sideBarActiveItemID="store">
  <div class="pb-12 mt-5">
    <div class="text-5xl font-bold mb-2">Our Store</div>
    <div class="text-2xl font-semibold mb-4">Handcrafted Goods & Toys</div>
    <div class="text-lg mb-8">
      Browse our selection of family-made wooden creations! We specialize in handcrafted toys—trains, cars, trucks, games, and more—each made with care and creativity. We also offer custom furniture, decor, and gifts. If you have a special request or want a custom toy, <a class="link link-accent" href="mailto:info@faithfulcraftsmen.com">contact us</a>!
    </div>
    <!-- TODO: Display wooden toys as a featured section when store launches -->
    <div class="alert alert-info mb-8">Our online store is coming soon! In the meantime, check our <a class="link link-accent" href="/about">About</a> or <a class="link link-accent" href="/services">Services</a> pages, or <a class="link link-accent" href="mailto:info@faithfulcraftsmen.com">contact us</a> for custom orders.</div>
  </div>
</BaseLayout>
