---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout sideBarActiveItemID="contact">
  <div class="pb-12 mt-8">
    <div class="text-5xl font-bold mb-2">Contact Us</div>
    <div class="text-2xl font-semibold mb-4">We’d Love to Hear from You!</div>
    <div class="text-lg mb-12">
      Have a question, want to request a custom project or toy, or just want to say hello? Reach out by email or visit us at an upcoming event!
    </div>
    <div class="mb-12">
      <a class="btn btn-accent" href="mailto:info@faithfulcraftsmen.com">Email Us</a>
    </div>
    <div class="text-2xl font-bold mb-2">Upcoming Markets & Events</div>
    <div class="text-base mb-12">
      We love meeting our community in person! Here’s where you can find us soon:
      <ul class="list-disc ml-6 mt-2">
        <li><b>June 6-7, 2025:</b> <a class="link link-accent" href="https://www.explorescottcountyva.org/event/nickelsville-days/" target="_blank">Nickelsville Days</a></li>
        <li><b>Saturdays (Summer):</b> Weekly Nickelsville Market (dates TBA when the market resumes this summer)</li>
      </ul>
      <div class="mt-4">Want to invite us to your event? <a class="link link-accent" href="mailto:info@faithfulcraftsmen.com">Let us know!</a></div>
    </div>
    <!-- Section Divider -->
    <div class="flex justify-center mb-12">
      <div class="w-full max-w-2xl border-t-2 border-dashed border-base-300"></div>
    </div>
  </div>
</BaseLayout>
